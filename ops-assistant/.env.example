# ops-assistant 环境变量示例
#
# 用法：复制本文件为 .env，再按需填写。.env 已被 .gitignore 忽略，只留在本机。
# 约定：
#   1. 所有变量都可以留空；留空时项目以纯规则模式运行（不调用任何模型，也不需要密钥）。
#   2. 本文件不含任何真实密钥；不要把真实 key 写进示例文件、代码、日志或截图。
#   3. 格式为 KEY=VALUE；值里不要加引号（除非常量本身需要）。
#   4. 项目根的 .env 只在变量尚未存在于当前进程环境时生效（不覆盖已有环境变量）。
#   5. OPS_MODEL 存在但 OPS_API_KEY 缺失时：llm_enabled=False，日志给出 WARNING，程序继续运行。

# ---- 对话模型（可选）----
# 形如 openai:gpt-4.1-mini、deepseek:deepseek-chat 或 dashscope:qwen-plus。
# 留空 = 纯规则模式：只跑确定性查询、计算、检索与报告模板，不调用模型。
OPS_MODEL=

# 当 OPS_MODEL 不带 "provider:" 前缀时使用，例如 openai / deepseek / dashscope / ollama。
# 模型名已带前缀时本变量可留空。
OPS_MODEL_PROVIDER=

# 模型密钥。只保存在本机 .env；不写日志、不回显、不提交。
OPS_API_KEY=

# OpenAI 兼容端点（OpenAI / DeepSeek / DashScope / Ollama 等）。
# 留空表示使用 provider 的官方默认地址。
OPS_BASE_URL=

# ---- 向量化（可选）----
# 留空 = 使用确定性哈希向量（HashingEmbeddings，教学用，不是语义模型）。
# 填入真实 embedding 模型名时走 OpenAI 兼容 embedding 接口；失败会自动回退到哈希向量。
OPS_EMBEDDING_MODEL=

# embedding 专用端点与密钥；留空则复用上面的 OPS_BASE_URL / OPS_API_KEY。
OPS_EMBEDDING_BASE_URL=
OPS_EMBEDDING_API_KEY=

# 哈希向量维度，默认 512；必须是正整数（改为其他值后需要重建知识索引）。
OPS_EMBEDDING_DIM=512

# ---- 执行预算（可选）----
# 单轮对话最大步数，默认 12；超过后以 budget_exceeded 结束而不是无限循环。
OPS_MAX_STEPS=12

# 单轮最大工具调用次数，默认 8；每次工具调用前检查。
OPS_MAX_TOOL_CALLS=8

# 单次模型请求超时时间（秒），默认 60。
# 说明：本项目补充变量（规格 5.1 的 Settings 含 request_timeout_s，但变量表未列出）。
OPS_REQUEST_TIMEOUT_S=60

# ---- 日志与运行环境（可选）----
# DEBUG / INFO / WARNING / ERROR / CRITICAL，默认 INFO；非法值会打警告并回退 INFO。
OPS_LOG_LEVEL=INFO

# dev / test / prod，默认 dev；非法值会打警告并回退 dev。
OPS_APP_ENV=dev
